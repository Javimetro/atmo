// ---- sensor ----

#define BME688_I2C_ADDR 0x76

Bsec2 envSensor;

float lastTemp = NAN;
float lastHumidity = NAN;
float lastIaq = NAN;
uint8_t lastIaqAccuracy = 0;

bsecSensor sensorList[] = {
  BSEC_OUTPUT_IAQ,
  BSEC_OUTPUT_RAW_TEMPERATURE,
  BSEC_OUTPUT_RAW_HUMIDITY,
};

// IAQ -> mood index (0 = 1/4 stars/worst, 3 = 4/4 stars/best). Bosch's
// own published IAQ bands.
int starsFromIaq(float iaq) {
  if (iaq <= 50) {
    return 3;
  } else if (iaq <= 100) {
    return 2;
  } else if (iaq <= 200) {
    return 1;
  } else {
    return 0;
  }
}

int currentMood = 1;
int currentStep = 0;
unsigned long lastFrameChange = 0;

void switchMood(int newMood) {
  currentMood = newMood;
  currentStep = 0;
  lastFrameChange = millis();
  applyStep(moodStepArrays[currentMood][0]);
  drawStarsForMood(currentMood);
}

void newDataCallback(const bme68xData data, const bsecOutputs outputs, Bsec2 bsec) {
  if (!outputs.nOutputs) {
    return;
  }

  float iaq = NAN;
  for (uint8_t i = 0; i < outputs.nOutputs; i++) {
    const bsecData output = outputs.output[i];
    switch (output.sensor_id) {
      case BSEC_OUTPUT_IAQ:
        iaq = output.signal;
        lastIaq = output.signal;
        lastIaqAccuracy = output.accuracy;
        break;
      case BSEC_OUTPUT_RAW_TEMPERATURE:
        lastTemp = output.signal;
        break;
      case BSEC_OUTPUT_RAW_HUMIDITY:
        lastHumidity = output.signal;
        break;
      default:
        break;
    }
  }

  if (!isnan(iaq)) {
    Serial.print("IAQ: ");
    Serial.print(iaq);
    Serial.print(" (accuracy ");
    Serial.print(lastIaqAccuracy);
    Serial.println(")");

    int newMood = starsFromIaq(iaq);
    if (newMood != currentMood) {
      switchMood(newMood);
    }
  }
}

// ---- stars + readout ----

#define COL_STAR_FILLED TFT_YELLOW
#define COL_STAR_EMPTY  0x39C7 // dim gray

const int8_t starX[10] = { 0, 2, 9, 4, 5, 0, -5, -4, -9, -2 };
const int8_t starY[10] = { -9, -3, -3, 1, 7, 4, 7, 1, -3, -3 };

void drawStar(int cx, int cy, bool filled) {
  uint16_t color = filled ? COL_STAR_FILLED : COL_STAR_EMPTY;
  for (int i = 0; i < 10; i++) {
    int j = (i + 1) % 10;
    tft.fillTriangle(cx, cy, cx + starX[i], cy + starY[i], cx + starX[j], cy + starY[j], color);
  }
}

const int STAR_RX = 212;
const int STAR_Y0 = 175;
const int STAR_SPACING = 24;

void drawStarsForMood(int moodIndex) {
  int filledCount = moodIndex + 1;
  for (int i = 0; i < 4; i++) {
    drawStar(STAR_RX + 10 + i * STAR_SPACING, STAR_Y0, i < filledCount);
  }
}

void drawReadoutLabels() {
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.setCursor(STAR_RX, 26, 2);
  tft.println("TEMP");
  tft.setCursor(STAR_RX, 86, 2);
  tft.println("HUMIDITY");
  tft.setCursor(STAR_RX, 148, 2);
  tft.println("AIR QUALITY");
}

void updateReadoutValues() {
  tft.setTextColor(TFT_WHITE, TFT_BLACK);

  tft.fillRect(STAR_RX, 42, 100, 26, TFT_BLACK);
  tft.setCursor(STAR_RX, 42, 4);
  tft.println(isnan(lastTemp) ? "--" : String(lastTemp, 1) + "C");

  tft.fillRect(STAR_RX, 102, 100, 26, TFT_BLACK);
  tft.setCursor(STAR_RX, 102, 4);
  tft.println(isnan(lastHumidity) ? "--" : String(lastHumidity, 1) + "%");
}

// ---- hold-to-peek IAQ overlay (joystick press) ----

const int OVERLAY_Y = 222;
const int OVERLAY_H = 18;

bool overlayOn = false;
unsigned long lastOverlayUpdate = 0;
const unsigned long OVERLAY_UPDATE_MS = 200;

void drawIaqOverlay() {
  tft.fillRect(0, OVERLAY_Y, 320, OVERLAY_H, TFT_BLACK);
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.setCursor(4, OVERLAY_Y, 2);
  tft.print("IAQ: ");
  tft.print(isnan(lastIaq) ? "--" : String(lastIaq, 1));
  tft.print("  (accuracy ");
  tft.print(lastIaqAccuracy);
  tft.print(")");
}

void clearIaqOverlay() {
  tft.fillRect(0, OVERLAY_Y, 320, OVERLAY_H, TFT_BLACK);
}

// ---- setup / loop ----

unsigned long lastSensorPoll = 0;
const unsigned long SENSOR_INTERVAL_MS = 1000;

unsigned long lastReadoutUpdate = 0;
const unsigned long READOUT_INTERVAL_MS = 5000;

void setup() {
  Serial.begin(115200);
  delay(1000);

  Wire.begin();
  pinMode(WIO_5S_PRESS, INPUT_PULLUP);

  tft.init();
  tft.setRotation(3);
  tft.fillScreen(TFT_BLACK);

  Serial.println("Atmo -- bring-up");

  if (!envSensor.begin(BME688_I2C_ADDR, Wire)) {
    Serial.println("BME688/BSEC not found -- check wiring/address, then reset the board.");
    while (true) {
      delay(1000);
    }
  }
  Serial.println("BME688 + BSEC found.");

  envSensor.updateSubscription(sensorList, ARRAY_LEN(sensorList), BSEC_SAMPLE_RATE_LP);
  if (envSensor.status < BSEC_OK) {
    Serial.print("BSEC subscription failed. Status code: ");
    Serial.println(envSensor.status);
    while (true) {
      delay(1000);
    }
  } else if (envSensor.status > BSEC_OK) {
    Serial.print("BSEC subscription warning (continuing anyway). Status code: ");
    Serial.println(envSensor.status);
  }

  envSensor.attachCallback(newDataCallback);

  applyStep(moodStepArrays[currentMood][0]);
  lastFrameChange = millis();
  drawReadoutLabels();
  drawStarsForMood(currentMood);
  updateReadoutValues();
}

void loop() {
  unsigned long now = millis();

  if (now - lastSensorPoll >= SENSOR_INTERVAL_MS) {
    lastSensorPoll = now;
    if (!envSensor.run()) {
      Serial.println("Error running BSEC.");
    }
  }

  unsigned long elapsed = now - lastFrameChange;
  const Step* steps = moodStepArrays[currentMood];
  int count = moodStepCounts[currentMood];
  if (elapsed >= steps[currentStep].holdMs) {
    currentStep = (currentStep + 1) % count;
    lastFrameChange = now;
    applyStep(steps[currentStep]);
  }

  if (now - lastReadoutUpdate >= READOUT_INTERVAL_MS) {
    lastReadoutUpdate = now;
    updateReadoutValues();
  }

  bool pressed = (digitalRead(WIO_5S_PRESS) == LOW);
  if (pressed) {
    if (!overlayOn || now - lastOverlayUpdate >= OVERLAY_UPDATE_MS) {
      overlayOn = true;
      lastOverlayUpdate = now;
      drawIaqOverlay();
    }
  } else if (overlayOn) {
    overlayOn = false;
    clearIaqOverlay();
  }
}
