// ImageTest -- all 4 mood animations (1/4..4/4), palette-indexed (4 bits
// per pixel, packed 2-per-byte) instead of raw 16-bit color, to fit
// flash budget: this cut total image data from ~845KB to ~130KB. A
// small palette table converts indices back to real RGB565 colors, and
// pushIndexed() unpacks into a scratch buffer before calling
// tft.pushImage() -- the buffer is reused for every push, sized for the
// biggest thing we ever draw (a full 200x200 base pose).
//
// This sketch cycles through all 4 moods in sequence, each playing its
// full idle animation, so we get an honest combined-size compile (every
// mood's data is actually referenced, not stripped as dead code like
// when we tested them one at a time) and a visual check that repacking
// didn't break anything.

#include <TFT_eSPI.h>

TFT_eSPI tft = TFT_eSPI();

const int IMG_SIZE = 200;
const int HIPPO_X0 = 2;
const int HIPPO_Y0 = (240 - IMG_SIZE) / 2;

// Palette: index -> real color. Order: black, dark outline, head gray,
// light gray, ear pink, white, cheek blush, red tongue, dusty ear
// (1/4), teardrop blue.
const uint16_t PALETTE[10] = { 0x0000, 0xA731, 0x318C, 0x14A5, 0x31A4, 0xBEF7, 0x6DA3, 0xECDA, 0xD093, 0xB88D };

// Scratch buffer for unpacking -- reused for every image/patch push.
// Sized for the largest thing we draw (a full 200x200 base pose).
uint16_t decodeBuf[IMG_SIZE * IMG_SIZE];

// Moved up from further down in the file -- Arduino's auto-generated
// function prototypes go at the very top of the file, before anything
// else, so applyStep()'s "const Step&" parameter needs Step defined
// here already or the auto-prototype fails to compile.
struct PatchRef {
  const uint8_t* data; // nullptr = unused slot
  int x, y, w, h;
};

struct Step {
  const uint8_t* baseImage; // nullptr = no full-image change this step
  PatchRef patches[4];      // up to 4 simultaneous patches; unused slots default to nullptr
  unsigned long holdMs;
};

// Unpacks a 4-bit-per-pixel array (2 pixels per byte, high nibble
// first) into decodeBuf and pushes it. w*h must not exceed the buffer.
void pushIndexed(int x, int y, int w, int h, const uint8_t* packed) {
  int n = w * h;
  for (int i = 0; i < n; i++) {
    uint8_t b = packed[i / 2];
    uint8_t idx = (i % 2 == 0) ? (b >> 4) : (b & 0x0F);
    decodeBuf[i] = PALETTE[idx];
  }
  tft.pushImage(x, y, w, h, decodeBuf);
}
