// ---- generic step/patch system, shared by all 4 moods ----
// (PatchRef/Step structs themselves are defined near the top of the file.)

void applyStep(const Step& s) {
  if (s.baseImage != nullptr) {
    pushIndexed(HIPPO_X0, HIPPO_Y0, IMG_SIZE, IMG_SIZE, s.baseImage);
  }
  for (int i = 0; i < 4; i++) {
    if (s.patches[i].data != nullptr) {
      pushIndexed(HIPPO_X0 + s.patches[i].x, HIPPO_Y0 + s.patches[i].y,
                  s.patches[i].w, s.patches[i].h, s.patches[i].data);
    }
  }
}

