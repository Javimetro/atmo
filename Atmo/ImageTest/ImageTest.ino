const int MOOD4_COUNT = sizeof(mood4Steps) / sizeof(mood4Steps[0]);

const Step* moodStepArrays[4] = { mood1Steps, mood2Steps, mood3Steps, mood4Steps };
const int moodStepCounts[4] = { MOOD1_COUNT, MOOD2_COUNT, MOOD3_COUNT, MOOD4_COUNT };

// How many loops of its own animation each mood plays before we cycle to
// the next mood, purely so this demo shows each one for a while instead
// of flashing through all 4 in a couple seconds.
const int LOOPS_PER_MOOD = 2;

int currentMood = 0;
int currentStep = 0;
int loopsDone = 0;
unsigned long lastFrameChange = 0;

// ---- stars + readout (same layout Javi already approved) ----

#define COL_STAR_FILLED TFT_YELLOW
#define COL_STAR_EMPTY  0x39C7 // dim gray

const int8_t starX[10] = { 0, 2, 9, 4, 5, 0, -5, -4, -9, -2 };
const int8_t starY[10] = { -9, -3, -3, 1, 7, 4, 7, 1, -3, -3 };

void drawStar(int cx, int cy, bool filled) {
  uint16_t color = filled ? COL_STAR_FILLED : COL_STAR_EMPTY;
  for (int i = 0; i < 10; i++) {
    int j = (i + 1) % 10;
    tft.fillTriangle(cx, cy, cx + starX[i], cy + starY[i], cx + starX[j], cy + starY[j], color);
  }
}

const int STAR_RX = 212;
const int STAR_Y0 = 175;
const int STAR_SPACING = 24;

// Redraws the stars for however many are filled (1-4), matching the
// current mood. moodIndex 0 = 1/4 stars ... moodIndex 3 = 4/4 stars.
void drawStarsForMood(int moodIndex) {
  int filledCount = moodIndex + 1;
  for (int i = 0; i < 4; i++) {
    drawStar(STAR_RX + 10 + i * STAR_SPACING, STAR_Y0, i < filledCount);
  }
}

void drawReadout() {
  tft.setTextColor(TFT_WHITE, TFT_BLACK);

  tft.setCursor(STAR_RX, 26, 2);
  tft.println("TEMP");
  tft.setCursor(STAR_RX, 42, 4);
  tft.println("22.3C"); // placeholder -- real sensor value comes later

  tft.setCursor(STAR_RX, 86, 2);
  tft.println("HUMIDITY");
  tft.setCursor(STAR_RX, 102, 4);
  tft.println("41%"); // placeholder -- real sensor value comes later

  tft.setCursor(STAR_RX, 148, 2);
  tft.println("AIR QUALITY");
}

void setup() {
  tft.init();
  tft.setRotation(3);
  tft.fillScreen(TFT_BLACK);

  applyStep(moodStepArrays[currentMood][0]); // draw the first mood's resting pose
  lastFrameChange = millis();

  drawReadout();
  drawStarsForMood(currentMood);
}

void loop() {
  unsigned long elapsed = millis() - lastFrameChange;
  const Step* steps = moodStepArrays[currentMood];
  int count = moodStepCounts[currentMood];

  if (elapsed >= steps[currentStep].holdMs) {
    currentStep++;
    if (currentStep >= count) {
      currentStep = 0;
      loopsDone++;
      if (loopsDone >= LOOPS_PER_MOOD) {
        loopsDone = 0;
        currentMood = (currentMood + 1) % 4;
        drawStarsForMood(currentMood); // stars follow the mood
      }
    }
    lastFrameChange = millis();
    applyStep(steps[currentStep]);
  }
}
